{
  "name": "faultline-milestone-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap:ids": "tsx scripts/bootstrap-ids.ts",
    "build:programs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-programs.ps1",
    "build:treasury:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-programs.ps1",
    "demo:guard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-guard-demo.ps1",
    "demo:exploit-v2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-treasury-demo.ps1 -Scenario v2 -AllowVulnerableV2",
    "demo:patch-v3": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-treasury-demo.ps1 -Scenario v3",
    "demo:proposal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-treasury-demo.ps1 -Scenario v3",
    "test:proposal-state-machine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-proposal-state-machine-tests.ps1",
    "test:challenge-commit-reveal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-challenge-commit-reveal-tests.ps1",
    "test:verifier-quorum": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-verifier-quorum-tests.ps1",
    "test:economic-settlement": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-economic-settlement-tests.ps1",
    "test": "npm run demo:guard",
    "test:guard": "npm run demo:guard",
    "test:treasury-versions": "npm run demo:exploit-v2 && npm run demo:patch-v3",
    "typecheck": "tsc --noEmit",
    "typecheck:m8-c1": "tsc -p packages/faultline-idl/tsconfig.json --noEmit && tsc -p packages/faultline-sdk/tsconfig.json --noEmit",
    "test:m8-c1": "tsx --test --test-concurrency=1 packages/faultline-sdk/tests/checkpoint1.test.ts",
    "test:m8-c3:commitment-parity": "tsx --test --test-concurrency=1 tests/milestone-8-checkpoint3-commitment-parity.test.ts",
    "test:m8-c3:loader-state": "tsx --test --test-concurrency=1 tests/milestone-8-checkpoint3-loader-state.test.ts",
    "test:m8-c3:cli-boundary": "tsx --test --test-concurrency=1 tests/milestone-8-checkpoint3-cli-boundary.test.ts",
    "test:m8-c3": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-milestone-8-checkpoint3.ps1",
    "verify:m8-idl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-milestone-8-idl.ps1 -Check"
  },
  "devDependencies": {
    "@solana/web3.js": "1.98.4",
    "@types/node": "22.18.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
